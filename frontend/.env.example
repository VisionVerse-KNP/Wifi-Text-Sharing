# Optional: force a specific backend URL (e.g. for production deploys where
# frontend and backend are on different hosts/ports). If unset, the app
# auto-detects the backend at the SAME hostname the page was loaded from,
# on VITE_SERVER_PORT (defaults to 4000) — this is what makes LAN usage work
# automatically from any device's IP or hostname.
# VITE_SERVER_URL=http://192.168.1.20:4000

VITE_SERVER_PORT=4000
